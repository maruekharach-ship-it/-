local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local MIN_SPEED, MAX_SPEED, DEFAULT_SPEED = 16, 100, 16
local speed = 32
local enabled = true

local function applySpeed()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.WalkSpeed = enabled and speed or DEFAULT_SPEED
	end
end

-- ===== GUI =====
local gui = Instance.new("ScreenGui")
gui.Name = "SpeedMenu"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(240, 140)
frame.Position = UDim2.new(0, 20, 0.5, -70)
frame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
frame.Active = true
frame.Draggable = true
frame.Parent = gui
Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

local label = Instance.new("TextLabel")
label.Size = UDim2.new(1, 0, 0, 36)
label.BackgroundTransparency = 1
label.TextColor3 = Color3.new(1, 1, 1)
label.Font = Enum.Font.GothamBold
label.TextSize = 18
label.Parent = frame

local track = Instance.new("Frame")
track.Size = UDim2.fromOffset(200, 8)
track.Position = UDim2.fromOffset(20, 60)
track.BackgroundColor3 = Color3.fromRGB(70, 70, 90)
track.Parent = frame
Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

local knob = Instance.new("Frame")
knob.Size = UDim2.fromOffset(20, 20)
knob.AnchorPoint = Vector2.new(0.5, 0.5)
knob.BackgroundColor3 = Color3.fromRGB(80, 170, 255)
knob.Parent = track
knob.Position = UDim2.fromScale(0, 0.5)
Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

local toggle = Instance.new("TextButton")
toggle.Size = UDim2.fromOffset(200, 30)
toggle.Position = UDim2.fromOffset(20, 92)
toggle.TextColor3 = Color3.new(1, 1, 1)
toggle.Font = Enum.Font.GothamMedium
toggle.TextSize = 16
toggle.Parent = frame
Instance.new("UICorner", toggle).CornerRadius = UDim.new(0, 8)

local function refresh()
	label.Text = "ความเร็ว: " .. speed
	knob.Position = UDim2.fromScale((speed - MIN_SPEED) / (MAX_SPEED - MIN_SPEED), 0.5)
	toggle.Text = enabled and "เปิดอยู่" or "ปิดอยู่"
	toggle.BackgroundColor3 = enabled and Color3.fromRGB(60, 170, 90) or Color3.fromRGB(170, 70, 70)
	applySpeed()
end

local function setFromX(x)
	local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
	speed = math.floor(MIN_SPEED + a * (MAX_SPEED - MIN_SPEED) + 0.5)
	refresh()
end

-- ===== Slider drag (เมาส์ + ทัช) =====
local dragging = false
local function isPointer(i)
	return i.UserInputType == Enum.UserInputType.MouseButton1
		or i.UserInputType == Enum.UserInputType.Touch
end

track.InputBegan:Connect(function(i)
	if isPointer(i) then dragging = true; setFromX(i.Position.X) end
end)
knob.InputBegan:Connect(function(i)
	if isPointer(i) then dragging = true end
end)
UIS.InputChanged:Connect(function(i)
	if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement
		or i.UserInputType == Enum.UserInputType.Touch) then
		setFromX(i.Position.X)
	end
end)
UIS.InputEnded:Connect(function(i)
	if isPointer(i) then dragging = false end
end)

toggle.Activated:Connect(function()
	enabled = not enabled
	refresh()
end)

-- ปุ่มลัด: [ ลดความเร็ว, ] เพิ่มความเร็ว
UIS.InputBegan:Connect(function(i, gp)
	if gp then return end
	if i.KeyCode == Enum.KeyCode.RightBracket then
		speed = math.min(speed + 4, MAX_SPEED); refresh()
	elseif i.KeyCode == Enum.KeyCode.LeftBracket then
		speed = math.max(speed - 4, MIN_SPEED); refresh()
	end
end)

-- ใช้ซ้ำหลังเกิดใหม่
player.CharacterAdded:Connect(function()
	task.wait(0.1)
	applySpeed()
end)

refresh()
